<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="psych_report"/>
      <Scaled Value="True"/>
      <ResourceType Value="res"/>
      <UseXPManifest Value="True"/>
      <XPManifest>
        <DpiAware Value="True"/>
      </XPManifest>
      <Icon Value="0"/>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
      <Item Name="Debug">
        <CompilerOptions>
          <Version Value="11"/>
          <Target>
            <Filename Value="psych_report"/>
          </Target>
          <SearchPaths>
            <IncludeFiles Value="$(ProjOutDir)"/>
            <Libraries Value="$(ProjPath)psych_report_core/build"/>
            <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
          </SearchPaths>
          <Parsing>
            <SyntaxOptions>
              <IncludeAssertionCode Value="True"/>
            </SyntaxOptions>
          </Parsing>
          <CodeGeneration>
            <Checks>
              <IOChecks Value="True"/>
              <RangeChecks Value="True"/>
              <OverflowChecks Value="True"/>
              <StackChecks Value="True"/>
            </Checks>
            <VerifyObjMethodCallValidity Value="True"/>
          </CodeGeneration>
          <Linking>
            <Debugging>
              <DebugInfoType Value="dsDwarf3"/>
              <UseHeaptrc Value="True"/>
              <TrashVariables Value="True"/>
            </Debugging>
            <Options>
              <PassLinkerOptions Value="True"/>
              <LinkerOptions Value="-z origin -rpath=\$ORIGIN/psych_report_core/build"/>
              <Win32>
                <GraphicApplication Value="True"/>
              </Win32>
            </Options>
          </Linking>
          <Other>
            <CustomOptions Value="-Fo$(ProjPath)psych_report_core/build"/>
            <ExecuteBefore>
              <Command Value="instantfpc build_core.pas ($ProjPath) ($TargetOS) Debug"/>
              <ScanForFPCMsgs Value="True"/>
              <ShowAllMessages Value="True"/>
              <CompileReasons Compile="False" Run="False"/>
            </ExecuteBefore>
          </Other>
        </CompilerOptions>
      </Item>
      <Item Name="Release">
        <CompilerOptions>
          <Version Value="11"/>
          <Target>
            <Filename Value="psych_report"/>
          </Target>
          <SearchPaths>
            <IncludeFiles Value="$(ProjOutDir)"/>
            <Libraries Value="$(ProjPath)psych_report_core/build"/>
            <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
          </SearchPaths>
          <CodeGeneration>
            <SmartLinkUnit Value="True"/>
            <Optimizations>
              <OptimizationLevel Value="3"/>
            </Optimizations>
          </CodeGeneration>
          <Linking>
            <Debugging>
              <GenerateDebugInfo Value="False"/>
              <RunWithoutDebug Value="True"/>
              <StripSymbols Value="True"/>
            </Debugging>
            <LinkSmart Value="True"/>
            <Options>
              <PassLinkerOptions Value="True"/>
              <LinkerOptions Value="-z origin -rpath=\$ORIGIN"/>
              <Win32>
                <GraphicApplication Value="True"/>
              </Win32>
            </Options>
          </Linking>
          <Other>
            <CustomOptions Value="-Fo$(ProjPath)psych_report_core/build/obj"/>
            <ExecuteBefore>
              <Command Value="instantfpc build_core.pas  ($ProjPath)  $(TargetOS) Release "/>
              <ScanForFPCMsgs Value="True"/>
              <ShowAllMessages Value="True"/>
              <CompileReasons Compile="False" Run="False"/>
            </ExecuteBefore>
            <ExecuteAfter>
              <Command Value="instantfpc assemble_release.pas"/>
              <ScanForFPCMsgs Value="True"/>
              <ShowAllMessages Value="True"/>
              <CompileReasons Compile="False" Run="False"/>
            </ExecuteAfter>
          </Other>
        </CompilerOptions>
      </Item>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="SQLDBLaz"/>
      </Item>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="psych_report.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="MainUnit.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="MainForm"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Form"/>
      </Unit>
      <Unit>
        <Filename Value="psychreportcore.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="PsychReportCore"/>
      </Unit>
      <Unit>
        <Filename Value="settings.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Settings"/>
      </Unit>
      <Unit>
        <Filename Value="settingseditorview.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="SettingsForm"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Form"/>
        <UnitName Value="SettingsEditorView"/>
      </Unit>
      <Unit>
        <Filename Value="appinterfaces.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="AppInterfaces"/>
      </Unit>
      <Unit>
        <Filename Value="recordingselectionpresenter.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="RecordingSelectionPresenter"/>
      </Unit>
      <Unit>
        <Filename Value="recordingselectionframe.pas"/>
        <IsPartOfProject Value="True"/>
        <ComponentName Value="RecordingSelectionFrame"/>
        <HasResources Value="True"/>
        <ResourceBaseClass Value="Frame"/>
        <UnitName Value="RecordingSelectionFrame"/>
      </Unit>
      <Unit>
        <Filename Value="coordinator.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="Coordinator"/>
      </Unit>
      <Unit>
        <Filename Value="settingseditorpresenter.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="SettingsEditorPresenter"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="psych_report"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <Libraries Value="$(ProjPath)psych_report_core/build"/>
      <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Linking>
      <Debugging>
        <DebugInfoType Value="dsDwarf3"/>
      </Debugging>
      <Options>
        <PassLinkerOptions Value="True"/>
        <LinkerOptions Value="-z origin -rpath=\$ORIGIN/psych_report_core/build"/>
        <Win32>
          <GraphicApplication Value="True"/>
        </Win32>
      </Options>
    </Linking>
    <Other>
      <CustomOptions Value="-Fo$(ProjPath)psych_report_core/build"/>
      <ExecuteBefore>
        <Command Value="instantfpc build_core.pas ($ProjPath) ($TargetOS)"/>
        <ScanForFPCMsgs Value="True"/>
        <ShowAllMessages Value="True"/>
        <CompileReasons Compile="False" Run="False"/>
      </ExecuteBefore>
    </Other>
  </CompilerOptions>
  <Debugging>
    <Exceptions>
      <Item>
        <Name Value="EAbort"/>
      </Item>
      <Item>
        <Name Value="ECodetoolError"/>
      </Item>
      <Item>
        <Name Value="EFOpenError"/>
      </Item>
    </Exceptions>
  </Debugging>
</CONFIG>
